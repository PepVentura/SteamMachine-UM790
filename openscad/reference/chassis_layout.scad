include <../../00_parametros.scad>;

use <../parts/01_bandeja/tray.scad>;

$fn = 64;


//=============================================================================
// ALTURAS
//=============================================================================

bottom_air_gap = 12;


//=============================================================================
// CHASIS EXTERIOR (REFERENCIA)
//=============================================================================

module case_reference()
{

    color([0.2,0.2,0.2,0.10])

    translate([
        -case_width/2,
        -case_depth/2,
        0
    ])

    cube([
        case_width,
        case_depth,
        case_height
    ]);

}


//=============================================================================
// BANDEJA
//=============================================================================

module tray_reference()
{

    color("LightGray")

    translate([
        -tray_width/2,
        -tray_depth/2,
        bottom_air_gap
    ])

    tray();

}


//=============================================================================
// UM790
//=============================================================================

module um790_reference()
{

    color([0,0.7,0,0.40])

    translate([
        -pcb_width/2,
        -pcb_depth/2,
        bottom_air_gap
        + tray_thickness
        + um790_post_height
    ])

    cube([
        pcb_width,
        pcb_depth,
        35
    ]);

}


//=============================================================================
// VENTILADOR
//=============================================================================

module fan_reference()
{

    color([0.15,0.15,0.15,0.60])

    translate([
        -60,
        -60,
        case_height-15
    ])

    cube([
        120,
        120,
        15
    ]);

}


//=============================================================================
// ESP32
//=============================================================================

module esp32_reference()
{

    color("RoyalBlue")

    translate([
        -27.5,
        -14,
        case_height-45
    ])

    cube([
        55,
        28,
        12
    ]);

}


//=============================================================================
// PLACA EXPANSIÓN
//=============================================================================

module expansion_reference()
{

    color("FireBrick")

    translate([
        -38,
        -38,
        case_height-48
    ])

    cube([
        76,
        76,
        2
    ]);

}


//=============================================================================
// LECTOR NFC
//=============================================================================

module nfc_reference()
{

    color("Gold")

    translate([
        -30,
        -case_depth/2+5,
        case_height-40
    ])

    cube([
        60,
        40,
        2
    ]);

}


//=============================================================================
// ENSAMBLAJE
//=============================================================================

case_reference();

tray_reference();

um790_reference();

fan_reference();

expansion_reference();

esp32_reference();

nfc_reference();
