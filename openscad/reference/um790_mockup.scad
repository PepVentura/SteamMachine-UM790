include <../../00_parametros.scad>;

$fn = 48;


//=============================================================================
// PARÁMETROS
//=============================================================================

board_x = pcb_width;
board_y = pcb_depth;

board_z = pcb_thickness;

// Altura total aproximada del equipo montado
heatsink_height = 32;


//=============================================================================
// PCB
//=============================================================================

module pcb()
{

    color([0.05,0.55,0.10])

    cube(
    [
        board_x,
        board_y,
        board_z
    ]);

}


//=============================================================================
// DISIPADOR
//=============================================================================

module heatsink()
{

    color([0.25,0.25,0.25])

    translate([
        8,
        8,
        board_z
    ])

    cube([
        board_x-16,
        board_y-16,
        heatsink_height
    ]);

}


//=============================================================================
// CONECTOR ALIMENTACIÓN
//=============================================================================

module power_connector()
{

    color("Black")

    translate([
        board_x-8,
        board_y/2-7,
        8
    ])

    cube([
        8,
        14,
        12
    ]);

}


//=============================================================================
// HDMI
//=============================================================================

module hdmi_connector()
{

    color("Silver")

    translate([
        board_x-14,
        20,
        5
    ])

    cube([
        14,
        12,
        6
    ]);

}


//=============================================================================
// RJ45
//=============================================================================

module ethernet_connector()
{

    color("Silver")

    translate([
        board_x-18,
        45,
        5
    ])

    cube([
        18,
        16,
        14
    ]);

}


//=============================================================================
// USB TRASEROS
//=============================================================================

module rear_usb()
{

    color("Silver")

    translate([
        board_x-16,
        70,
        5
    ])

    cube([
        16,
        14,
        8
    ]);


    translate([
        board_x-16,
        88,
        5
    ])

    cube([
        16,
        14,
        8
    ]);

}


//=============================================================================
// USB FRONTALES
//=============================================================================

module front_usb()
{

    color("Silver")

    translate([
        -14,
        30,
        5
    ])

    cube([
        14,
        14,
        8
    ]);


    translate([
        -14,
        48,
        5
    ])

    cube([
        14,
        14,
        8
    ]);

}


//=============================================================================
// BOTÓN POWER
//=============================================================================

module power_button()
{

    color("Red")

    translate([
        -2,
        15,
        10
    ])

    cylinder(
        h=2,
        d=4
    );

}


//=============================================================================
// ENSAMBLAJE
//=============================================================================

module um790_mockup()
{

    pcb();

    heatsink();

    power_connector();

    hdmi_connector();

    ethernet_connector();

    rear_usb();

    front_usb();

    power_button();

}


//=============================================================================
// PREVIEW
//=============================================================================

if($preview)
{

    um790_mockup();

}
