include <../../../00_parametros.scad>;

$fn = 64;


//=============================================================================
// BASE
//=============================================================================

module base()
{

    difference()
    {

        //---------------------------------------------------------------------
        // PLACA BASE
        //---------------------------------------------------------------------

        cube(
        [
            tray_width,
            tray_depth,
            tray_thickness
        ]);



        //---------------------------------------------------------------------
        // VACIADO CENTRAL
        //---------------------------------------------------------------------

        translate(
        [
            base_frame_width,
            base_frame_width,
            -0.1
        ])

        cube(
        [
            tray_width - base_frame_width*2,
            tray_depth - base_frame_width*2,
            tray_thickness + 0.2
        ]);

    }



    //---------------------------------------------------------------------
    // ISLAS DE LOS POSTES
    //---------------------------------------------------------------------

    for(x=[-1,1])
    for(y=[-1,1])
    {

        translate(
        [
            tray_width/2 + x*off_x - base_island_size/2,
            tray_depth/2 + y*off_y - base_island_size/2,
            0
        ])

        cube(
        [
            base_island_size,
            base_island_size,
            tray_thickness
        );

    }



    //---------------------------------------------------------------------
    // PUENTE HORIZONTAL
    //---------------------------------------------------------------------

    translate(
    [
        tray_width/2-off_x,
        tray_depth/2-base_bridge_width/2,
        0
    ])

    cube(
    [
        off_x*2,
        base_bridge_width,
        tray_thickness
    ]);



    //---------------------------------------------------------------------
    // PUENTE VERTICAL
    //---------------------------------------------------------------------

    translate(
    [
        tray_width/2-base_bridge_width/2,
        tray_depth/2-off_y,
        0
    ])

    cube(
    [
        base_bridge_width,
        off_y*2,
        tray_thickness
    ]);



}



//=============================================================================
// EXPORTACIÓN
//=============================================================================

base();



//=============================================================================
// PREVIEW
//=============================================================================

if($preview)
{

    color("LightGray")
        base();

}
