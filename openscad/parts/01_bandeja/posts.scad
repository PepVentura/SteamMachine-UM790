include <../../../00_parametros.scad>;

$fn = 64;


//=============================================================================
// POSTE INDIVIDUAL
//=============================================================================

module post()
{
    difference()
    {
        cylinder(
            h = standoff_height,
            d = standoff_dia
        );

        translate([0,0,-0.1])

        cylinder(
            h = insert_depth + 0.2,
            d = insert_dia
        );
    }
}


//=============================================================================
// CONJUNTO DE POSTES
//=============================================================================

module posts()
{

    translate([-off_x,-off_y,0])
        post();

    translate([ off_x,-off_y,0])
        post();

    translate([ off_x, off_y,0])
        post();

    translate([-off_x, off_y,0])
        post();

}


//=============================================================================
// PREVIEW
//=============================================================================

posts();
