include <../../../00_parametros.scad>;

$fn = 64;


//=============================================================================
// POSTE M3
//=============================================================================

module post()
{

    difference()
    {

        //---------------------------------------------------------------------
        // Cuerpo del poste
        //---------------------------------------------------------------------

        cylinder(
            h = um790_post_height,
            d = um790_post_diameter
        );

        //---------------------------------------------------------------------
        // Alojamiento del inserto M3
        //---------------------------------------------------------------------

        translate([0,0,um790_post_height-insert_depth])

            cylinder(
                h = insert_depth + 0.10,
                d = insert_diameter
            );

    }

}


//=============================================================================
// CONJUNTO DE POSTES
//=============================================================================

module posts()
{

    translate([ off_x,  off_y, 0]) post();

    translate([-off_x,  off_y, 0]) post();

    translate([-off_x, -off_y, 0]) post();

    translate([ off_x, -off_y, 0]) post();

}


//=============================================================================
// PREVIEW
//=============================================================================

color("Orange")
posts();
