include <../../../00_parametros.scad>;

$fn = 80;


//=============================================================================
// POSTE INDIVIDUAL
//=============================================================================

module post()
{

    difference()
    {

        //--------------------------------------------------
        // Poste exterior
        //--------------------------------------------------

        union()
        {

            // Base reforzada

            cylinder(
                h = 2,
                d = standoff_dia + 4
            );

            // Poste principal

            translate([0,0,2])

                cylinder(
                    h = standoff_height,
                    d = standoff_dia
                );

        }


        //--------------------------------------------------
        // Inserto M3
        //--------------------------------------------------

        translate([0,0,-0.1])

            cylinder(
                h = insert_depth + 0.2,
                d = insert_dia
            );


        //--------------------------------------------------
        // Chaflán superior
        //--------------------------------------------------

        translate([0,0,insert_depth-1])

            cylinder(
                h = 1.2,
                d1 = insert_dia + 1,
                d2 = insert_dia
            );

    }

}



//=============================================================================
// CONJUNTO
//=============================================================================

module posts()
{

    translate([-off_x,-off_y,0])
        post();

    translate([ off_x,-off_y,0])
        post();

    translate([ off_x, off_y,0])
        post();

    translate([-off_x, off_y,0])
        post();

}



//=============================================================================
// PREVIEW
//=============================================================================

posts();
