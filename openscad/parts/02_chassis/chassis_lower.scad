include <../../../00_parametros.scad>;

use <../01_bandeja/tray.scad>;

$fn = 64;


//=============================================================================
// PARÁMETROS DEL CHASIS
//=============================================================================

air_gap = 12;

support_diameter = 20;
support_height   = air_gap;

floor_rib_width  = 3;
floor_rib_height = 6;


//=============================================================================
// FONDO DEL CHASIS
//=============================================================================

module chassis_floor()
{

    cube(
    [
        case_width,
        case_depth,
        bottom_thickness
    ]);

}


//=============================================================================
// CONTORNO EXTERIOR
//=============================================================================

module chassis_outline()
{

    difference()
    {

        cube(
        [
            case_width,
            case_depth,
            case_height
        ]);


        translate(
        [
            wall_thickness,
            wall_thickness,
            bottom_thickness
        ])

        cube(
        [
            case_width-(wall_thickness*2),
            case_depth-(wall_thickness*2),
            case_height
        ]);

    }

}


//=============================================================================
// BASE DEL CHASIS
//=============================================================================

module chassis_lower()
{

    union()
    {

        //-----------------------------------------------------------------
        // Fondo
        //-----------------------------------------------------------------

        chassis_floor();


        //-----------------------------------------------------------------
        // Paredes exteriores
        //-----------------------------------------------------------------

        chassis_outline();

    }

}


//=============================================================================
// PREVIEW
//=============================================================================

translate(
[
    -case_width/2,
    -case_depth/2,
    0
])

color("Gainsboro")

    chassis_lower();
