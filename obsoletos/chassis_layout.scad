include <../../00_parametros.scad>;

use <../parts/01_bandeja/tray.scad>;

$fn = 64;


//=============================================================================
// CONFIGURACIÓN
//=============================================================================

bottom_air_gap = 12;

wall = wall_thickness;


//=============================================================================
// CHASIS TRANSPARENTE
//=============================================================================

module chassis_reference()
{

    color([0.75,0.75,0.75,0.12])

    difference()
    {

        translate([
            -case_width/2,
            -case_depth/2,
            0
        ])

        cube([
            case_width,
            case_depth,
            case_height
        ]);


        translate([
            -case_width/2+wall,
            -case_depth/2+wall,
            wall
        ])

        cube([
            case_width-2*wall,
            case_depth-2*wall,
            case_height
        ]);

    }

}


//=============================================================================
// BANDEJA
//=============================================================================

module tray_reference()
{

    translate([
        -tray_width/2,
        -tray_depth/2,
        bottom_air_gap
    ])

    color("LightGray")

    tray();

}


//=============================================================================
// UM790
//=============================================================================

module um790_reference()
{

    color([0.10,0.70,0.10,0.70])

    translate([
        -pcb_width/2,
        -pcb_depth/2,
        bottom_air_gap
        + tray_thickness
        + um790_post_height
    ])

    cube([
        pcb_width,
        pcb_depth,
        35
    ]);

}


//=============================================================================
// VENTILADOR
//=============================================================================

module fan_reference()
{

    color([0.10,0.10,0.10,0.70])

    translate([
        -60,
        -60,
        case_height-15
    ])

    cube([
        120,
        120,
        15
    ]);

}


//=============================================================================
// ESP32
//=============================================================================

module esp32_reference()
{

    color("RoyalBlue")

    translate([
        -27.5,
        -14,
        case_height-38
    ])

    cube([
        55,
        28,
        12
    ]);

}


//=============================================================================
// PLACA EXPANSIÓN
//=============================================================================

module shield_reference()
{

    color("FireBrick")

    translate([
        -38,
        -38,
        case_height-42
    ])

    cube([
        76,
        76,
        2
    ]);

}


//=============================================================================
// NFC
//=============================================================================

module nfc_reference()
{

    color("Gold")

    translate([
        -30,
        -case_depth/2+5,
        case_height-45
    ])

    cube([
        60,
        40,
        2
    ]);

}


//=============================================================================
// EJES
//=============================================================================

module axis()
{

    color("Red")
    cube([200,1,1]);

    color("Green")
    cube([1,200,1]);

    color("Blue")
    cube([1,1,200]);

}


//=============================================================================
// ENSAMBLAJE
//=============================================================================

axis();

chassis_reference();

tray_reference();

um790_reference();

fan_reference();

shield_reference();

esp32_reference();

nfc_reference();
